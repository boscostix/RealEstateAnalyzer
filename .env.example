APP_ENV=development
LOG_LEVEL=INFO
HASDATA_API_KEY=
HASDATA_API_KEY_FILE=secrets/hasdata_api_key.txt
ZILLOW_USE_HASDATA=true
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5-mini
OPENAI_AGENT_PROMPT_VERSION=v1
OPENAI_AGENT_MAX_TURNS=6
OPENAI_AGENT_TIMEOUT_SECONDS=30.0
OPENAI_AGENT_WORKFLOW_TIMEOUT_SECONDS=90.0
OPENAI_AGENT_MAX_PARALLEL_AGENTS=4
OPENAI_AGENT_RETRY_ATTEMPTS=1
OPENAI_AGENT_TRACING_ENABLED=true
OPENAI_AGENT_WORKFLOW_NAME=real_estate_agent_research
OPENAI_AGENT_TRACE_SENSITIVE_DATA=false
ENABLE_LIVE_AGENT_RESEARCH_TESTS=false
OPENAI_COMMITTEE_MODEL=gpt-5-mini
OPENAI_COMMITTEE_PROMPT_VERSION=v1
OPENAI_COMMITTEE_MAX_TURNS=6
OPENAI_COMMITTEE_TIMEOUT_SECONDS=30.0
OPENAI_COMMITTEE_RETRY_ATTEMPTS=1
OPENAI_COMMITTEE_TRACING_ENABLED=true
OPENAI_COMMITTEE_WORKFLOW_NAME=investment_committee
OPENAI_COMMITTEE_TRACE_SENSITIVE_DATA=false
ENABLE_LIVE_INVESTMENT_COMMITTEE_TESTS=false
